NODE_ENV=

# MongoDB (the same database the backend uses)
MONGO_PASSWORD=
DATABASE_LOCAL=

# Redis (judge queue, verdict channel and contest leaderboard)
REDIS_URL=

# Where job directories are created. When the worker runs in a container, mount this
# path at the same location inside and outside (see compose.yaml). Default: /opt/maat-jobs
JOBS_DIR=

# How many submissions this worker judges at once. Default: 2
WORKER_CONCURRENCY=