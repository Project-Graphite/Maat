{
  "name": "maat-worker",
  "version": "1.0.0",
  "description": "Ma'at worker",
  "main": "src/server.js",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "nodemon src/server.js",
    "start:prod": "cross-env NODE_ENV=production node src/server.js",
    "debug": "node --inspect src/server.js",
    "lint": "prettier --check .",
    "ad": "vitest run tests/adversarial",
