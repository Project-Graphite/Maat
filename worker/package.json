    "int": "vitest run tests/integration",
    "test": "vitest run --exclude \"tests/adversarial/**\""
  },
  "dependencies": {
    "bullmq": "^6.3.16",
    "dotenv": "^17.2.2",
    "ioredis": "^6.0.0",
    "mongoose": "^8.24.6"
  },
  "devDependencies": {
    "cross-env": "^10.0.0",
    "nodemon": "3.1.11",
    "prettier": "^3.6.2",
    "vitest": "^5.0.5"
  }
}
