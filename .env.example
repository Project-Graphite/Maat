NODE_ENV =
PORT =
MONGO_PASSWORD=
DATABASE_LOCAL=
JWT_SECRET = 
JWT_EXPIRES_IN =
JWT_COOKIE_EXPIRES_IN =
API_RATE_LIMIT=

# Public URL of the site, used in password reset links
FRONTEND_URL=

# SMTP settings for password reset emails. Leave EMAIL_HOST empty in development:
# the email is printed in the backend logs instead.
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=

# MinIO file storage (generated)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Redis (judge queue and contest leaderboard). Use a long random password
REDIS_PASSWORD=
REDIS_URL=

# Where job directories are created. When the worker runs in a container, mount this
# path at the same location inside and outside (see compose.yaml). Default: /opt/maat-jobs
JOBS_DIR=

# How many submissions this worker judges at once. Default: 2
WORKER_CONCURRENCY=

# Optional. Cores every sandbox is pinned to, for example 0-3. Empty means any core
SANDBOX_CPUSET=
# Public address of the site, for canonical links and social previews (frontend build)
VITE_SITE_URL=
# Contact address shown on the privacy policy and terms of use (frontend build)
VITE_CONTACT_EMAIL=
